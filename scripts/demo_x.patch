+// ── Value labels (the project page's one-axis demo) ──────────────────────────
+// Text on a sprite that faces the camera and keeps one size on screen. Its canvas keeps one
+// size (three allocates the texture once) and is drawn again only when the text changes.
+const WBT_LABEL_W = 400; // canvas px
+const WBT_LABEL_H = 80;
+const WBT_LABEL_PILL = 0.8; // the pill's share of the canvas height
+const WBT_FORCE_HEAD_LEN = 0.045; // an arrow head's height, as in makeForceArrow
+const WBT_PROBE = typeof location !== 'undefined' && new URLSearchParams(location.search).has('probe');
+
+type WbtLabel = {
+  sprite: THREE.Sprite;
+  canvas: HTMLCanvasElement;
+  texture: THREE.CanvasTexture;
+  text: string; // as drawn
+  boxW: number; // the pill's width, canvas px
+};
+
+function makeLabelSprite(): WbtLabel {
+  const canvas = document.createElement('canvas');
+  canvas.width = WBT_LABEL_W;
+  canvas.height = WBT_LABEL_H;
+  const texture = new THREE.CanvasTexture(canvas);
+  texture.generateMipmaps = false;
+  texture.minFilter = THREE.LinearFilter;
+  // Colours as on the arrows: their linear values, tone-mapped alike.
+  texture.colorSpace = THREE.NoColorSpace;
+  const material = new THREE.SpriteMaterial({
+    map: texture,
+    transparent: true,
+    depthTest: false,
+    depthWrite: false,
+    sizeAttenuation: false,
+  });
+  const sprite = new THREE.Sprite(material);
+  sprite.renderOrder = 1010; // above the arrows and the markers
+  sprite.scale.set(0, 0, 1); // sized on screen by layoutLabels before it is first drawn
+  return { sprite, canvas, texture, text: '', boxW: 0 };
+}
+
+// A force as written beside its arrow: one decimal, a true minus, no "−0.0".
+function wbtNewtons(v: number): string {
+  const r = Math.round(v * 10) / 10;
+  return `${r < 0 ? '\u2212' : ''}${Math.abs(r).toFixed(1)} N`;
 }
 
+// Draw runs of text ('sym' the italic F of the page's maths, 'sup' its superscript, 'txt'
+// plain) on a dark pill, outlined in `rgb` and lettered in a light tint of it; grey without.
+function drawLabel(label: WbtLabel, runs: Array<['sym' | 'sup' | 'txt', string]>, rgb: [number, number, number] | null): void {
+  const text = runs.map((r) => r[1]).join('');
+  if (text === label.text) return;
+  label.text = text;
+  const ctx = label.canvas.getContext('2d');
+  if (!ctx) return;
+  const fonts = {
+    sym: "italic 48px 'Times New Roman', Times, serif",
+    sup: '600 26px ui-sans-serif, system-ui, sans-serif',
+    txt: '600 36px ui-sans-serif, system-ui, sans-serif',
+  };
+  const widths = runs.map(([f, s]) => {
+    ctx.font = fonts[f];
+    return ctx.measureText(s).width + (f === 'sym' ? 3 : 0);
+  });
+  const pad = 20;
+  const pillH = WBT_LABEL_H * WBT_LABEL_PILL;
+  const boxW = Math.min(WBT_LABEL_W - 4, widths.reduce((a, b) => a + b, 0) + 2 * pad);
+  const x0 = (WBT_LABEL_W - boxW) / 2;
+  const y0 = (WBT_LABEL_H - pillH) / 2;
+  label.boxW = boxW;
+  ctx.clearRect(0, 0, WBT_LABEL_W, WBT_LABEL_H);
+  ctx.beginPath();
+  ctx.roundRect(x0, y0, boxW, pillH, pillH / 2);
+  ctx.fillStyle = 'rgba(14, 17, 23, 0.86)';
+  ctx.fill();
+  const c = rgb ? rgb.map((v) => Math.round(255 * v)) : null;
+  if (c) {
+    ctx.lineWidth = 3;
+    ctx.strokeStyle = `rgb(${c[0]}, ${c[1]}, ${c[2]})`;
+    ctx.stroke();
+  }
+  // A light tint of the arrow's colour, so that the letters read on the dark pill.
+  ctx.fillStyle = c ? `rgb(${c.map((v) => Math.round(v + 0.45 * (255 - v))).join(', ')})` : 'rgb(214, 219, 227)';
+  ctx.textBaseline = 'alphabetic';
+  const base = y0 + pillH / 2 + 13;
+  let x = x0 + pad;
+  runs.forEach(([f, s], i) => {
+    ctx.font = fonts[f];
+    ctx.fillText(s, x, f === 'sup' ? base - 18 : base);
+    x += widths[i];
+  });
+  label.texture.needsUpdate = true;
+}
