+      mjData.xfrc_applied[off + 0] += fwx;
+      mjData.xfrc_applied[off + 1] += fwy;
+      mjData.xfrc_applied[off + 2] += fwz;
+      mjData.xfrc_applied[off + 3] += tx;
+      mjData.xfrc_applied[off + 4] += ty;
+      mjData.xfrc_applied[off + 5] += tz;
+    }
+  }
